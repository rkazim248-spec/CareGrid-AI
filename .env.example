# ============================================================================
# CareGrid AI — environment template
#
# COPY TO .env.local AND FILL IN. NEVER COMMIT .env.local
# NEVER put a real value in THIS file.
# Anything prefixed NEXT_PUBLIC_ is visible in the browser.
#
# Source of truth: docs/21_ENVIRONMENT_VARIABLES.md
#
# ---------------------------------------------------------------------------
# PHASE 3 — the backend foundation
# ---------------------------------------------------------------------------
# The application shell needs NONE of these. Every page, layout, and component
# in this build renders without any of them, and the API answers honestly:
# `GET /api/health` returns 200 `degraded`, and every other route returns
# 503 `SERVICE_UNAVAILABLE` with a sentence naming the variables to set. It
# does NOT pretend to be signed in.
#
# There is deliberately NO PLACEHOLDER API KEY anywhere in this file. A fake key
# produces a Firebase or Google error that looks exactly like a network fault,
# and a reviewer loses an afternoon to it. See lib/env.client.ts.
#
# Which phase reads what:
#   Phase 2  Firebase Admin credentials, the app URL, the re-auth window
#   Phase 3  everything below is READ and REPORTED by
#            GET /api/admin/system/health, and Gemini/Maps/Twilio are wired to
#            their provider boundaries. None of them is CALLED yet.
#   Phase 4  GEMINI_API_KEY becomes live
#   Phase 6  GOOGLE_MAPS_SERVER_KEY and NEXT_PUBLIC_GOOGLE_MAPS_API_KEY
#   Phase 9  the Twilio triple
# ============================================================================

# ---------- Application ----------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_ENV=development          # development | staging | production
APP_TIMEZONE=Asia/Kolkata
LOG_LEVEL=info                           # debug | info | warn | error
REAUTH_WINDOW_SEC=300                    # privileged-action freshness window
REQUEST_TIMEOUT_MS=15000                 # global handler budget; a breach is 504
# Salts the stored IP hash. Rotates daily in production (docs/21 §6). Under 8
# characters is refused: an unsalted SHA-256 of an IPv4 address is brute-forceable
# in seconds, so a short "salt" is the same as no salt.
IP_HASH_SALT=


# ---------- Firebase (public web config — NOT a secret) ----------
# Phase 2. The web config is designed for the browser, so it ships in the
# bundle; it is still environment-specific and still restricted by HTTP
# referrer and API enablement in the Cloud console.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Point every SDK at the local emulator suite. See "Using the emulators" below.
# NEXT_PUBLIC_FIREBASE_USE_EMULATORS=true

# ---------- Firebase (server only — SECRET) ----------
# Phase 2. THE single most dangerous credential in the project: the Admin SDK
# bypasses Firestore Security Rules entirely, which is what makes the role
# server-authoritative. Never behind a NEXT_PUBLIC_ prefix, never in a client
# bundle. `lib/server/firebase-admin.ts` is the only consumer.
#
# On Windows, a PEM pasted into a CI secret store often arrives with literal
# "\n" instead of newlines. `lib/env.server.ts` restores them, so a signature
# error here is almost always a credential, not a clock.
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ---------- Auth behaviour ----------
# docs/10 §3.1. Enable Email/Password and Google in the Firebase console.
# Leave phone, anonymous, and email-link DISABLED: anonymous would create a uid
# with no users/{uid} document, and every other provider adds a `provider` enum
# value that docs/07 §3 does not have.
FIREBASE_AUTH_PROVIDERS=email,google

# ---------- Gemini (server only — SECRET) ----------
# Phase 3: the provider boundary is wired and reports `configured: false`.
# Phase 4: GEMINI_API_KEY becomes live. Until then every call returns
# 502 AI_UNAVAILABLE and the incident records `triageSource: fallback` (FR-029).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_MS=20000
GEMINI_MAX_RETRIES=3
GEMINI_RPM_LIMIT=8
GEMINI_RPD_LIMIT=200
GEMINI_AUDIO_ENABLED=true
AI_REPAIR_ATTEMPTS=1
AI_CONFIDENCE_REVIEW_THRESHOLD=0.6
AI_ENABLE_LOCAL_QUOTA_GUARD=true

# ---------- Google Maps ----------
# Phase 3 boundary only; Phase 6 makes these live. BOTH keys must be
# application-restricted: the browser key by HTTP referrer, the server key by IP.
# They are DIFFERENT credentials with DIFFERENT restrictions. Putting the server
# key behind NEXT_PUBLIC_ publishes it — and `serverEnvProblems()` treats a
# NEXT_PUBLIC_ value containing "-----BEGIN" as a configuration fault.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_SERVER_KEY=
GOOGLE_MAPS_REGION=IN
GOOGLE_MAPS_DEFAULT_CENTER=17.4478,78.4874
GEOCODING_RPM_LOCAL=30
NEXT_PUBLIC_MAP_STYLE=dark
NEXT_PUBLIC_MAP_ZOOM_DEFAULT=13
NEXT_PUBLIC_MAP_ZOOM_MAX=18

# ---------- Twilio (server only — SECRETS) ----------
# Phase 3 boundary only; Phase 9 makes these live. Billed per segment (SMS) and
# per conversation (WhatsApp), so a flood is a bill. `PATCH /api/me` refuses
# `notifPrefs.sms: true` and `.whatsapp: true` with 422 NOTIFICATION_DISABLED
# until an account exists — a stored preference the system cannot honour is worse
# than not offering the switch.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=

# ---------- Feature flags ----------
ENABLE_VOICE_REPORTING=false
ENABLE_RISK_ZONES=false
ENABLE_SMS_NOTIFICATIONS=false        # no provider: PATCH /api/me refuses true
ENABLE_WHATSAPP_NOTIFICATIONS=false   # no provider: PATCH /api/me refuses true
NOTIFICATION_RETRY_LIMIT=2
DISPATCH_EXPIRY_SEC=120
RESPONDER_HEARTBEAT_SEC=60
STALE_LOCATION_MIN=15
UPLOAD_MAX_IMAGE_BYTES=5242880
UPLOAD_MAX_AUDIO_BYTES=15728640
UPLOAD_SIGNED_URL_TTL_SEC=900
STAGING_UPLOAD_SWEEP_MIN=30
SLA_BREACH_SWEEP=on_write

# ---------- Rate limiting ----------
RATE_LIMIT_STORE=firestore            # docs/10 §17.1: a token bucket in Firestore,
                                      # because a Vercel function is stateless
                                      # and an in-memory bucket resets per invoke
RATE_LIMIT_WINDOW_SEC=3600
RATE_LIMIT_TRUST_PROXY=true

# ---------- Ops ----------
CRON_SECRET=                            # required in production; the /api/cron
                                        # bearer. Compared in CONSTANT TIME.
ALLOW_SEED=false                        # true AND non-production to run scripts/seed.ts
                                        # `serverEnvProblems()` reports it as a FAULT
                                        # in a production build.
SEED_DEMO_PASSWORD=                     # demo seeding only; never committed
ENABLE_MAINTENANCE_JOBS=false
# SENTRY_DSN=

# ============================================================================
# Using the emulators (optional, recommended for local auth work)
# ============================================================================
#
#   firebase login
#   firebase use --add your-project-id
#   firebase emulators:start --only auth,firestore,storage
#
# Then set NEXT_PUBLIC_FIREBASE_USE_EMULATORS=true in .env.local and restart.
# Two things to know:
#
#   1. The Auth emulator ACCEPTS ANY PASSWORD for an existing account and any
#      6+ character password for a new one. Do not treat a passing emulator
#      password test as evidence about password strength.
#   2. The Firestore emulator loads `firestore.rules`. `tests/integration/`
#      (Phase 10) is where the rules assertions live; the Phase 2 unit tests
#      deliberately avoid the emulator so `npm test` needs no Java runtime.
# ============================================================================
