# ============================================================================

# CareGrid AI — environment template

#

# COPY THIS FILE TO .env.local AND FILL IN YOUR REAL VALUES.

# NEVER COMMIT .env.local.

# NEVER put real secrets in THIS file.

#

# Anything prefixed NEXT_PUBLIC_ is exposed to the browser.

# Server-only secrets MUST NEVER use NEXT_PUBLIC_.

#

# Source of truth:

# docs/21_ENVIRONMENT_VARIABLES.md

#

# Current providers:

# Firebase    → Authentication + Firestore + Realtime

# Gemini      → AI emergency triage

# Mapbox      → Maps + location visualization

# ImageKit    → Emergency image/evidence storage

# AssemblyAI  → Voice-to-text transcription

#

# ============================================================================

# ============================================================================

# APPLICATION

# ============================================================================

NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_ENV=development

# development | staging | production

APP_TIMEZONE=Asia/Karachi

LOG_LEVEL=info

# debug | info | warn | error

REAUTH_WINDOW_SEC=300

# Privileged-action freshness window.

REQUEST_TIMEOUT_MS=15000

# Global handler budget. A breach becomes a 504.

IP_HASH_SALT=

# REQUIRED in production.

# Use a long random value.

# Do not use a short/common string.

# ============================================================================

# FIREBASE — PUBLIC WEB CONFIG

# ============================================================================

#

# These values are used by the browser Firebase SDK.

# Firebase web API keys/configuration are not treated as server secrets.

#

# Configure Firebase Authentication and Firestore security rules separately.

# ============================================================================

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Optional Firebase emulator support.

# Leave empty/false when using the real Firebase project.

#

# NEXT_PUBLIC_FIREBASE_USE_EMULATORS=false

# ============================================================================

# FIREBASE — SERVER ADMIN SDK

# ============================================================================

#

# SECRET.

# NEVER use NEXT_PUBLIC_.

#

# The Firebase Admin SDK can bypass Firestore Security Rules.

# Keep these credentials server-side only.

# ============================================================================

FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ============================================================================

# FIREBASE AUTHENTICATION

# ============================================================================

FIREBASE_AUTH_PROVIDERS=email,google

# Supported application providers:

# email,google

# ============================================================================

# GEMINI — AI EMERGENCY TRIAGE

# ============================================================================

#

# SERVER ONLY — SECRET

#

# NEVER rename this to NEXT_PUBLIC_GEMINI_API_KEY.

# NEVER expose the Gemini key to the browser.

# ============================================================================

GEMINI_API_KEY=

GEMINI_MODEL=gemini-2.5-flash

GEMINI_TIMEOUT_MS=20000

GEMINI_MAX_RETRIES=3

# Retries should be limited to temporary provider failures such as

# 429/503 where supported by the implementation.

GEMINI_RPM_LIMIT=8

# Local per-instance quota guard.

GEMINI_RPD_LIMIT=200

# Local per-instance daily quota guard.

GEMINI_AUDIO_ENABLED=true

AI_REPAIR_ATTEMPTS=1

# Number of schema-repair attempts after invalid AI output.

AI_CONFIDENCE_REVIEW_THRESHOLD=0.6

# Below this value, the incident should be marked for human review.

AI_ENABLE_LOCAL_QUOTA_GUARD=true

# ============================================================================

# AI DEVELOPMENT MOCK

# ============================================================================

#

# Development only.

#

# When enabled without a real Gemini key, the application can use the

# existing deterministic mock/fallback behavior.

#

# NEVER rely on mock mode in production.

# ============================================================================

AI_MOCK_MODE=

# ============================================================================

# MAPBOX — MAPS + LOCATION

# ============================================================================

#

# Public browser token.

#

# Mapbox public tokens may be used by client-side applications.

# Restrict the token appropriately in the Mapbox dashboard.

#

# NEVER put a Mapbox secret/server token in NEXT_PUBLIC_.

# ============================================================================

NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=

MAPBOX_DEFAULT_ZOOM=13

MAPBOX_MAX_ZOOM=18

NEXT_PUBLIC_MAP_STYLE=dark

# ============================================================================

# MAP + LOCATION SETTINGS

# ============================================================================

# Duplicate detection radius.

# Allowed application range: 100–2000 meters.

DUPLICATE_RADIUS_METERS=500

# Duplicate lookback period in hours.

DUPLICATE_LOOKBACK_HOURS=6

# Text similarity threshold for confirmed duplicate suggestion.

DUPLICATE_TEXT_CONFIRM=0.60

# Combined score threshold for potential duplicate suggestion.

DUPLICATE_POTENTIAL=0.55

# Maximum candidates considered during duplicate detection.

DUPLICATE_MAX_CANDIDATES=50

# ============================================================================

# IMAGEKIT — IMAGE / EVIDENCE STORAGE

# ============================================================================

#

# Public key:

# Client-safe.

#

# Private key:

# SERVER ONLY — SECRET.

#

# NEVER expose IMAGEKIT_PRIVATE_KEY with NEXT_PUBLIC_.

# ============================================================================

NEXT_PUBLIC_IMAGEKIT_PUBLIC_KEY=

IMAGEKIT_PRIVATE_KEY=

IMAGEKIT_URL_ENDPOINT=

# ============================================================================

# UPLOAD LIMITS

# ============================================================================

UPLOAD_MAX_IMAGE_BYTES=5242880

# 5 MB

UPLOAD_MAX_AUDIO_BYTES=15728640

# 15 MB

UPLOAD_SIGNED_URL_TTL_SEC=900

# 15 minutes

# ============================================================================

# ASSEMBLYAI — SPEECH TO TEXT

# ============================================================================

#

# SERVER ONLY — SECRET.

#

# NEVER use NEXT_PUBLIC_ASSEMBLYAI_API_KEY.

# The browser must never receive this credential.

# ============================================================================

ASSEMBLYAI_API_KEY=

# ============================================================================

# VOICE / FEATURE FLAGS

# ============================================================================

ENABLE_VOICE_REPORTING=false

ENABLE_RISK_ZONES=false

ENABLE_SMS_NOTIFICATIONS=false

ENABLE_WHATSAPP_NOTIFICATIONS=false

# ============================================================================

# TWILIO — OPTIONAL FUTURE SMS / WHATSAPP

# ============================================================================

#

# NOT REQUIRED FOR THE CURRENT MVP.

#

# Keep these empty until Twilio is intentionally integrated.

# These services may introduce usage costs.

# ============================================================================

TWILIO_ACCOUNT_SID=

TWILIO_AUTH_TOKEN=

TWILIO_WHATSAPP_NUMBER=

# ============================================================================

# NOTIFICATION SETTINGS

# ============================================================================

NOTIFICATION_RETRY_LIMIT=2

# ============================================================================

# DISPATCH SETTINGS

# ============================================================================

DISPATCH_EXPIRY_SEC=120

RESPONDER_HEARTBEAT_SEC=60

STALE_LOCATION_MIN=15

# ============================================================================

# RATE LIMITING

# ============================================================================

RATE_LIMIT_STORE=firestore

RATE_LIMIT_WINDOW_SEC=3600

RATE_LIMIT_TRUST_PROXY=true

# ============================================================================

# OPERATIONS / CRON

# ============================================================================

CRON_SECRET=

ALLOW_SEED=false

SEED_DEMO_PASSWORD=

ENABLE_MAINTENANCE_JOBS=false

# ============================================================================

# STAGING / MAINTENANCE

# ============================================================================

STAGING_UPLOAD_SWEEP_MIN=30

SLA_BREACH_SWEEP=on_write

# ============================================================================

# OPTIONAL ERROR MONITORING

# ============================================================================

# SENTRY_DSN=

# ============================================================================

# FIREBASE EMULATORS — OPTIONAL

# ============================================================================

#

# To use Firebase emulators locally:

#

# firebase login

# firebase use --add YOUR_PROJECT_ID

# firebase emulators:start --only auth,firestore,storage

#

# Then set:

#

# NEXT_PUBLIC_FIREBASE_USE_EMULATORS=true

#

# Restart the Next.js development server after changing environment variables.

#

# ============================================================================

# ============================================================================

# SECURITY REMINDERS

# ============================================================================

#

# NEVER commit:

# .env.local

# .env.production.local

# .env.development.local

#

# NEVER expose:

# GEMINI_API_KEY

# FIREBASE_PRIVATE_KEY

# FIREBASE_CLIENT_EMAIL

# IMAGEKIT_PRIVATE_KEY

# ASSEMBLYAI_API_KEY

# CRON_SECRET

# SEED_DEMO_PASSWORD

# IP_HASH_SALT

#

# Client-safe variables:

# NEXT_PUBLIC_FIREBASE_*

# NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN

# NEXT_PUBLIC_IMAGEKIT_PUBLIC_KEY

# NEXT_PUBLIC_APP_URL

#

# Even client-safe values should be restricted/configured correctly.

#

# ============================================================================

# ============================================================================

# END OF FILE

# ============================================================================
