          "fieldPath": "deletedAt",
          "order": "ASCENDING"
        },
        {
          "fieldPath": "status",
          "order": "IN"
        },
        {
          "fieldPath": "category",
          "order": "IN"
        },
        {
          "fieldPath": "updatedAt",
          "order": "DESCENDING"
        }
      ]
    },
    {
      "//": "Index 13 (Phase 8) - L1 assigned/unassigned. docs/11 2.2 calls this \"index 5\"; the shipped #5 is `users role`, so this is the index the document names that was never created. Note it must list `status IN` after `assigneeUid` to match the query field order.",
      "collectionGroup": "incidents",
      "queryScope": "COLLECTION",
      "fields": [
        {
          "fieldPath": "deletedAt",
          "order": "ASCENDING"
        },
        {
          "fieldPath": "assigneeUid",
          "order": "ASCENDING"
        },
        {
          "fieldPath": "status",
          "order": "IN"
        },
        {
          "fieldPath": "updatedAt",
          "order": "DESCENDING"
        }
      ]
    },
    {
      "//": "Index 14 (Phase 8) - L1 ordered by createdAt rather than updatedAt. The queue supports both (docs/11 2.2).",
      "collectionGroup": "incidents",
      "queryScope": "COLLECTION",
      "fields": [
        {
          "fieldPath": "deletedAt",
          "order": "ASCENDING"
        },
        {
          "fieldPath": "status",
          "order": "IN"
        },
        {
          "fieldPath": "createdAt",
          "order": "DESCENDING"
        }
      ]
    },
    {
      "//": "Index 15 (Phase 8) - L3 mapIncidents. The shipped index 6 omits `deletedAt`, so QD-8 (\"the where set must be a prefix of the index\") is not satisfied and the listener would fail. Phase 6 added deletedAt to the map query, which is the soft-delete guarantee, and the index has to follow.",
      "collectionGroup": "incidents",
      "queryScope": "COLLECTION",
      "fields": [
        {
          "fieldPath": "geoCells",
          "order": "ARRAY_CONTAINS"
        },
        {
          "fieldPath": "deletedAt",
          "order": "ASCENDING"
        },
        {
          "fieldPath": "status",
          "order": "IN"
        },
        {
          "fieldPath": "updatedAt",
          "order": "DESCENDING"
        }
      ]
    },
    {
      "//": "Index 16 (Phase 8) - L4 mapLocations: status != offline, freshest first. docs/07 7.2 says so in prose; no index existed.",
      "collectionGroup": "responderLocations",
      "queryScope": "COLLECTION",
      "fields": [
        {
          "fieldPath": "status",
          "order": "ASCENDING"
        },
        {
          "fieldPath": "capturedAt",
          "order": "DESCENDING"
        }
      ]
    },
    {
      "//": "Index 17 (Phase 8) - L5 notification listener, matching the recipientId field written by dispatch and enforced by rules.",
      "collectionGroup": "notifications",
      "queryScope": "COLLECTION",
      "fields": [
        {
          "fieldPath": "recipientId",
          "order": "ASCENDING"
        },
        {
          "fieldPath": "createdAt",
          "order": "DESCENDING"
        }
      ]
    },
    {
      "//": "Index 18 (Phase 8) - L6. Index 8 omits `status`, so the active/accepted window had no working index.",
      "collectionGroup": "dispatches",
      "queryScope": "COLLECTION",
      "fields": [
        {
          "fieldPath": "responderUid",
          "order": "ASCENDING"
        },
        {
