node_modules/
.next/
out/
build/
dist/

# Environment — never commit a real secret (docs/21 §1)
#
# AUDIT FIX: `.env.production`, `.env.staging` and `.env.development` were NOT
# ignored. Every rule here ended in `.local`, so a file named for an environment
# without that suffix fell straight through — and `.env.production` is a
# conventional Next.js filename that a developer or a deploy script will create
# without thinking about it, which is the whole failure mode this list exists to
# prevent. Verified with `git check-ignore` on each name, not by reading the file.
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env*.local
# Environment-named files WITHOUT the `.local` suffix. A separate rule rather than
# a broadened glob, because `.env*` would also swallow `.env.example` and the
# negation below would have to be maintained in step with it.
.env.*
!.env.example
!.env*.example
!.env.*.example

# Private credentials — never in version control, whatever it is called.
# The Firebase service account is the highest-value credential in this project:
# the Admin SDK bypasses Firestore Security Rules entirely (docs/22 §2), so a
# leaked key is total access to every document. A `.json` is not sufficient
# protection — a PEM with a different extension is the same key.
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
*service-account*.json
*serviceAccount*.json
firebase-adminsdk-*.json
gcp-service-account*.json
google-services.json
**/credentials*.json
**/secrets*.json

# Test / tooling output
coverage/
test-results/
playwright-report/
blob-report/
.playwright/
*.tsbuildinfo
next-env.d.ts

# Agent tooling scratch space. These are git WORKTREES — complete second
# checkouts of this repository, created inside the working directory. Git
# already declines to descend into one (a directory holding a `.git` file is a
# separate repository), so this is belt-and-braces against the case where that
# protection does not apply: a stale or partially-copied worktree would
# otherwise add a duplicate of every source file to the index.
.kilo/

# Agent tooling installed into the working directory. Not project source, and not
# committable — a skill library is not a dependency of CareGrid AI.
.claude/
.freebuff/
skills-lock.json

# Editor / OS
.DS_Store
Thumbs.db
.idea/
*.log
npm-install.log

# Deployment — the Vercel CLI link file records the project id and org id.
.vercel/
